* text=auto

# Code
*.cs        text diff=csharp eol=lf
*.shader    text eol=lf
*.hlsl      text eol=lf
*.cginc     text eol=lf
*.compute   text eol=lf
*.asmdef    text eol=lf
*.asmref    text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.uss       text eol=lf
*.uxml      text eol=lf
*.inputactions text eol=lf

# Unity YAML (Force Text serialization). Configure the driver locally:
#   git config merge.unityyamlmerge.driver '<UnityYAMLMerge> merge -p %O %B %A %A'
*.unity       text eol=lf merge=unityyamlmerge linguist-generated
*.prefab      text eol=lf merge=unityyamlmerge linguist-generated
*.asset       text eol=lf merge=unityyamlmerge linguist-generated
*.mat         text eol=lf merge=unityyamlmerge linguist-generated
*.anim        text eol=lf merge=unityyamlmerge linguist-generated
*.controller  text eol=lf merge=unityyamlmerge linguist-generated
*.overrideController text eol=lf merge=unityyamlmerge linguist-generated
*.physicMaterial text eol=lf merge=unityyamlmerge linguist-generated
*.mask        text eol=lf merge=unityyamlmerge linguist-generated
*.playable    text eol=lf merge=unityyamlmerge linguist-generated
*.lighting    text eol=lf merge=unityyamlmerge linguist-generated
*.meta        text eol=lf merge=unityyamlmerge linguist-generated
*.wlt         text eol=lf linguist-generated

# Binary (LFS)
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.a     filter=lfs diff=lfs merge=lfs -text
*.aar   filter=lfs diff=lfs merge=lfs -text
*.cubemap filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
LightingData.asset filter=lfs diff=lfs merge=lfs -text
